{
  "_note": "Do NOT add a top-level productName or change name. Electron derives the userData path from it, and lycore-invoicing is where the existing encrypted database lives. The display name is set under build.productName instead.",
  "name": "lycore-invoicing",
  "version": "3.1.0",
  "description": "LYCORE GROUP LLC desktop app: leads, calling and invoicing",
  "main": "main.js",
  "author": "LYCORE GROUP LLC",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jsdom": "^30.0.1",
    "otplib": "^12.0.1"
  },
  "build": {
    "appId": "com.lycoregroup.invoicing",
    "productName": "LYCORE Desk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lycoregroup-website-flagship",
        "repo": "lycore-invoicing",
        "private": false,
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}